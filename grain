

"""
grain.py - Cài đặt mã dòng Grain v1 và Grain-128.

Ký hiệu (giống README.md):
    s : LFSR, danh sách bit s[0], s[1], ...
    b : NFSR, danh sách bit b[0], b[1], ...
    z : bit keystream

Mỗi nhịp, thanh ghi bỏ bit đầu s[0] và thêm 1 bit mới vào cuối.
"""


# ===== Đổi byte <-> bit (người số 1) =====

def bytes_to_bits(data, lsb_first=True):
    """b'\\x01' -> [1,0,0,0,0,0,0,0] (LSB-first) hoặc [0,0,0,0,0,0,0,1] (MSB-first)."""
    order = range(8) if lsb_first else range(7, -1, -1)
    return [(byte >> i) & 1 for byte in data for i in order]


def bits_to_bytes(bits, lsb_first=True):
    """Ngược lại của bytes_to_bits."""
    order = list(range(8)) if lsb_first else list(range(7, -1, -1))
    result = []
    for k in range(0, len(bits), 8):
        byte = 0
        for bit, i in zip(bits[k:k + 8], order):
            byte |= bit << i
        result.append(byte)
    return bytes(result)

# ===== Grain v1: LFSR =====

def lfsr_feedback(s):
    """Hàm f: bit mới của LFSR."""
    return s[0] ^ s[13] ^ s[23] ^ s[38] ^ s[51] ^ s[62]


# ===== Grain v1: NFSR =====

def nfsr_feedback(b, s0):
    """Hàm g: bit mới của NFSR (cộng thêm bit s0 của LFSR)."""
    return (s0 ^ b[0] ^ b[9] ^ b[14] ^ b[21] ^ b[28] ^ b[33] ^ b[37]
            ^ b[45] ^ b[52] ^ b[60] ^ b[62]
            ^ (b[63] & b[60]) ^ (b[37] & b[33]) ^ (b[15] & b[9])
            ^ (b[60] & b[52] & b[45]) ^ (b[33] & b[28] & b[21])
            ^ (b[63] & b[45] & b[28] & b[9]) ^ (b[60] & b[52] & b[37] & b[33])
            ^ (b[63] & b[60] & b[21] & b[15])
            ^ (b[63] & b[60] & b[52] & b[45] & b[37])
            ^ (b[33] & b[28] & b[21] & b[15] & b[9])
            ^ (b[52] & b[45] & b[37] & b[33] & b[28] & b[21]))

def clock_nfsr(b: list[int], s0: int, extra: int = 0) -> None:
    """Dịch NFSR 1 nhịp. `s0` là bit s[i] của LFSR (lấy TRƯỚC khi dịch LFSR)."""
    new_bit = nfsr_feedback(b, s0) ^ extra
    b.pop(0)
    b.append(new_bit)


# ===== HÀM ĐẦU RA, KHỞI TẠO, KEYSTREAM (người số 4) =====

def h(x0: int, x1: int, x2: int, x3: int, x4: int) -> int:
    """Hàm lọc Boolean h của Grain v1."""
    return (x1 ^ x4 ^ (x0 & x3) ^ (x2 & x3) ^ (x3 & x4)
            ^ (x0 & x1 & x2) ^ (x0 & x2 & x3) ^ (x0 & x2 & x4)
            ^ (x1 & x2 & x4) ^ (x2 & x3 & x4))


def output_bit(s: list[int], b: list[int]) -> int:
    """z = b1^b2^b4^b10^b31^b43^b56 ^ h(s3, s25, s46, s64, b63)."""
    return (b[1] ^ b[2] ^ b[4] ^ b[10] ^ b[31] ^ b[43] ^ b[56]
            ^ h(s[3], s[25], s[46], s[64], b[63]))


class GrainV1:
    """Grain v1: khóa 80 bit (10 byte), IV 64 bit (8 byte)."""

    KEY_BYTES = KEY_BITS // 8
    IV_BYTES = IV_BITS // 8
    LSB_FIRST = True

    def __init__(self, key: bytes, iv: bytes, init_clocks: int = INIT_CLOCKS):
        """`init_clocks` mặc định 160; giảm xuống chỉ để thử nghiệm tấn công."""
        self.s: list[int] = []
        self.b: list[int] = []
        self._load_key_iv(key, iv)
        self._initialize(init_clocks)

    def _load_key_iv(self, key: bytes, iv: bytes) -> None:
        """b = key, s = IV + các bit 1 cho đủ độ dài thanh ghi."""
        name = type(self).__name__
        if len(key) != self.KEY_BYTES:
            raise ValueError(f"{name} cần khóa {self.KEY_BYTES} byte, nhận được {len(key)} byte")
        if len(iv) != self.IV_BYTES:
            raise ValueError(f"{name} cần IV {self.IV_BYTES} byte, nhận được {len(iv)} byte")
        self.b = bytes_to_bits(key, self.LSB_FIRST)
        iv_bits = bytes_to_bits(iv, self.LSB_FIRST)
        self.s = iv_bits + [1] * (len(self.b) - len(iv_bits))

    def _output(self) -> int:
        return output_bit(self.s, self.b)

    def _clock(self, extra: int = 0) -> None:
        """Dịch cả hai thanh ghi 1 nhịp."""
        s0 = self.s[0]
        clock_lfsr(self.s, extra)
        clock_nfsr(self.b, s0, extra)

    def _initialize(self, clocks: int) -> None:
        """Chạy `clocks` nhịp, bit z được XOR ngược vào cả LFSR và NFSR."""
        for _ in range(clocks):
            self._clock(self._output())

    def next_bit(self) -> int:
        """Xuất 1 bit keystream."""
        z = self._output()
        self._clock()
        return z

    def keystream(self, n_bytes: int) -> bytes:
        """Sinh n_bytes byte keystream."""
        bits = [self.next_bit() for _ in range(8 * n_bytes)]
        return bits_to_bytes(bits, self.LSB_FIRST)

    def encrypt(self, data: bytes) -> bytes:
        """Bản mã = bản rõ XOR keystream."""
        ks = self.keystream(len(data))
        return bytes(d ^ k for d, k in zip(data, ks))

    decrypt = encrypt